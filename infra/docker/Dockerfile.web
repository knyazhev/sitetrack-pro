FROM node:20-alpine AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps apps
COPY libs libs
RUN npm ci --workspace @tooltrack/web
RUN npm run build --workspace @tooltrack/web

FROM node:20-alpine
WORKDIR /app
COPY --from=build /workspace/apps/web/dist ./dist
RUN npm install -g serve
CMD ["serve", "-s", "dist", "-l", "4174"]
